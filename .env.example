# SaathiAI Environment Configuration
# Copy this file to .env and fill in the values you need.
# Never commit your real .env file.

# ── LLM Backend ───────────────────────────────────────────────────────────────
# Choose ONE backend:
#   huggingface    → Local HuggingFace transformers (needs GPU or patience on CPU)
#   ollama         → Local Ollama server (recommended for self-hosting)
#   openai_compat  → Any OpenAI-compatible API (LM Studio, Together AI, etc.)
#   hf_api         → HuggingFace Inference API (cloud, needs HF_API_TOKEN)

LLM_BACKEND=ollama

# ── HuggingFace Local Inference ───────────────────────────────────────────────
HF_MODEL_ID=google/gemma-2b-it
HF_MAX_NEW_TOKENS=1024
HF_TEMPERATURE=0.3
HF_DEVICE=cpu

# ── Ollama (recommended for local self-hosted inference) ──────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b

# ── OpenAI-Compatible API (LM Studio, Together AI, Groq, etc.) ───────────────
OPENAI_COMPAT_BASE_URL=http://localhost:1234/v1
OPENAI_COMPAT_API_KEY=not-needed
OPENAI_COMPAT_MODEL=gemma-2b-it

# ── HuggingFace Inference API (cloud fallback) ────────────────────────────────
# Get your token at: https://huggingface.co/settings/tokens
HF_API_TOKEN=
HF_API_MODEL=google/gemma-2-2b-it

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Document Processing ───────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# ── Retrieval ─────────────────────────────────────────────────────────────────
TOP_K_RESULTS=5
